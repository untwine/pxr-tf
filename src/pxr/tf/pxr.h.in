#ifndef PXR_TF_H
#define PXR_TF_H

#include <pxr/arch/pxr.h>

#ifdef PXR_PYTHON_SUPPORT_ENABLED
#include <pxr/boost/python/common.hpp>
#endif

#define TF_MAJOR_VERSION @PROJECT_VERSION_MAJOR@
#define TF_MINOR_VERSION @PROJECT_VERSION_MINOR@
#define TF_PATCH_VERSION @PROJECT_VERSION_PATCH@

#define TF_VERSION (TF_MAJOR_VERSION * 10000 \
                  + TF_MINOR_VERSION * 100   \
                  + TF_PATCH_VERSION)

#define PXR_NS pxr
#define TF_INTERNAL_NS pxrInternal_v@PROJECT_VERSION_MAJOR@_@PROJECT_VERSION_MINOR@_@PROJECT_VERSION_PATCH@__pxrReserved__
#define PXR_NS_GLOBAL ::PXR_NS

namespace TF_INTERNAL_NS { }

namespace PXR_NS {
    using namespace TF_INTERNAL_NS;
}

// Import direct dependencies into tf's internal namespace.
// This keeps resolution correct if package versions ever drift.
namespace TF_INTERNAL_NS {
    using namespace ARCH_INTERNAL_NS;
#ifdef PXR_PYTHON_SUPPORT_ENABLED
    using namespace BOOST_INTERNAL_NS;
#endif
}

#define TF_NAMESPACE_OPEN_SCOPE   namespace TF_INTERNAL_NS {
#define TF_NAMESPACE_CLOSE_SCOPE  }
#define TF_NAMESPACE_USING_DIRECTIVE using namespace PXR_NS;

#endif // PXR_TF_H
